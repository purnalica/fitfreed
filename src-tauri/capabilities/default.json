{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the FitFreed main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://account.polar.com/*"
        },
        {
          "url": "https://support.polar.com/en/how-to-download-all-your-data-from-polar-flow"
        },
        {
          "url": "https://support.polar.com/es/how-to-download-all-your-data-from-polar-flow"
        }
      ]
    }
  ]
}
