{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-resolution-v9.schema.json",
  "title": "FitFreed resolved report version 9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition", "resolvedSnapshotRef", "status", "session", "routes",
    "trainingComparison", "plannedTraining", "provenance", "sensitiveContents",
    "limitations", "runParameters"
  ],
  "properties": {
    "definition": { "$ref": "report-resolution-v8.schema.json#/properties/definition" },
    "resolvedSnapshotRef": {
      "$ref": "report-resolution-v8.schema.json#/properties/resolvedSnapshotRef"
    },
    "status": { "$ref": "report-resolution-v8.schema.json#/properties/status" },
    "session": { "$ref": "report-resolution-v8.schema.json#/properties/session" },
    "routes": { "$ref": "report-resolution-v8.schema.json#/properties/routes" },
    "trainingComparison": {
      "$ref": "report-resolution-v8.schema.json#/properties/trainingComparison"
    },
    "plannedTraining": {
      "$ref": "report-resolution-v8.schema.json#/properties/plannedTraining"
    },
    "provenance": { "$ref": "report-resolution-v8.schema.json#/properties/provenance" },
    "sensitiveContents": {
      "$ref": "report-resolution-v8.schema.json#/properties/sensitiveContents"
    },
    "limitations": { "$ref": "report-resolution-v8.schema.json#/properties/limitations" },
    "runParameters": {
      "$ref": "report-run-parameters-v1.schema.json#/$defs/resolved"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "object",
                "properties": { "kind": { "const": "planned-training" } }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "resolvedSnapshotRef": {
            "$ref": "report-definition-v5.schema.json#/$defs/plannedSnapshotRef"
          },
          "session": { "type": "null" },
          "routes": { "type": "array", "maxItems": 0 },
          "trainingComparison": { "type": "null" },
          "plannedTraining": {
            "$ref": "report-resolution-v8.schema.json#/$defs/plannedTrainingEvidence"
          },
          "provenance": {
            "type": "object",
            "properties": { "kind": { "const": "planned-training-snapshot" } },
            "required": ["kind"]
          },
          "sensitiveContents": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "type": "object",
        "properties": { "plannedTraining": { "type": "null" } }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "object",
                "properties": { "kind": { "const": "session" } }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-search-v4.schema.json#/$defs/session"
          },
          "provenance": {
            "type": "object",
            "properties": { "kind": { "const": "session" } },
            "required": ["kind"]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "session": { "type": "null" },
          "routes": { "type": "array", "maxItems": 0 },
          "sensitiveContents": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "object",
                "properties": { "kind": { "enum": ["question", "exploration"] } }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "trainingComparison": {
            "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-comparison-v1.schema.json"
          },
          "provenance": {
            "type": "object",
            "properties": { "kind": { "const": "library-snapshot" } },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "object",
                "properties": { "kind": { "const": "blank" } }
              }
            }
          },
          "trainingComparison": { "type": "null" }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "provenance": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "authored-only" } }
          }
        }
      },
      "else": {
        "if": {
          "type": "object",
          "properties": {
            "definition": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "object",
                  "properties": { "kind": { "const": "blank" } }
                }
              }
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "provenance": {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "library-snapshot" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "trainingComparison": { "type": "null" } }
      },
      "then": {
        "type": "object",
        "properties": {
          "runParameters": {
            "type": "object",
            "properties": { "trainingComparison": { "type": "null" } }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "runParameters": {
            "type": "object",
            "properties": {
              "trainingComparison": {
                "$ref": "report-run-parameters-v1.schema.json#/$defs/resolvedTrainingComparison"
              }
            }
          }
        }
      }
    }
  ]
}
