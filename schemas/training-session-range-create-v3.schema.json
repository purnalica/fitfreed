{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-range-create-v3.schema.json",
  "title": "FitFreed training-session range creation version 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "snapshotRef", "exerciseRef", "coordinate", "title", "startedAtElapsedMilliseconds", "endedAtElapsedMilliseconds"],
  "properties": {
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "exerciseRef": { "type": "string", "pattern": "^exercise-[0-9a-f]{64}$" },
    "coordinate": { "$ref": "#/$defs/coordinate" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "startedAtElapsedMilliseconds": { "$ref": "#/$defs/elapsedMilliseconds" },
    "endedAtElapsedMilliseconds": { "$ref": "#/$defs/positiveMilliseconds" }
  },
  "$defs": {
    "elapsedMilliseconds": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 19 },
    "positiveMilliseconds": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 19 },
    "coordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": { "scope": { "const": "exercise-elapsed" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "routeRef"],
          "properties": {
            "scope": { "const": "route-elapsed" },
            "routeRef": { "type": "string", "pattern": "^route-[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "signalRef"],
          "properties": {
            "scope": { "const": "signal-elapsed" },
            "signalRef": { "type": "string", "pattern": "^signal-[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
