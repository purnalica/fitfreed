{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-refresh-v1.schema.json",
  "title": "FitFreed deliberate report refresh version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportRef",
    "expectedRevision",
    "expectedSourceSnapshotRef",
    "expectedResolvedSnapshotRef"
  ],
  "properties": {
    "reportRef": { "$ref": "report-definition-v4.schema.json#/$defs/reportRef" },
    "expectedRevision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "expectedSourceSnapshotRef": {
      "$ref": "report-definition-v4.schema.json#/$defs/snapshotRef"
    },
    "expectedResolvedSnapshotRef": {
      "$ref": "report-definition-v4.schema.json#/$defs/snapshotRef"
    }
  }
}
