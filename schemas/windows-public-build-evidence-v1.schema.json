{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/windows-public-build-evidence-v1.schema.json",
  "title": "FitFreed Windows public build evidence version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "release",
    "target",
    "application",
    "artifacts",
    "trust",
    "update",
    "verification"
  ],
  "properties": {
    "format": { "const": "org.fitfreed.windows-public-build-evidence" },
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "generatedAt"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "target": {
      "const": {
        "id": "windows-x86_64-nsis",
        "os": "windows",
        "architecture": "x86_64",
        "packageFormat": "nsis",
        "installMode": "currentUser"
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "identifier", "executable", "storageSchemaVersion"],
      "properties": {
        "productName": { "const": "FitFreed" },
        "identifier": { "const": "org.fitfreed.desktop" },
        "executable": { "const": "fitfreed.exe" },
        "storageSchemaVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "inventory"],
      "properties": {
        "package": { "$ref": "#/$defs/packageArtifact" },
        "inventory": { "$ref": "#/$defs/inventoryArtifact" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticodeCertificateSha256"],
      "properties": {
        "authenticodeCertificateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "metadataEndpoint", "trustedKeyIds"],
      "properties": {
        "contract": { "const": "stable-v3" },
        "metadataEndpoint": {
          "const": "https://fitfreed.org/updates/stable.json"
        },
        "trustedKeyIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      }
    },
    "verification": {
      "const": [
        { "id": "windows-package-contract", "result": "passed" },
        { "id": "windows-public-setup-trust", "result": "passed" },
        { "id": "windows-current-user-installation", "result": "passed" },
        { "id": "windows-installed-authenticode", "result": "passed" },
        { "id": "windows-package-inventory", "result": "passed" },
        { "id": "windows-clean-removal", "result": "passed" }
      ]
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/\\\\]+$", "maxLength": 255 },
        "kind": {
          "enum": [
            "windows-x86_64-nsis",
            "windows-package-inventory"
          ]
        },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "type": "object", "properties": { "kind": { "const": "windows-x86_64-nsis" } } }
      ]
    },
    "inventoryArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "type": "object", "properties": { "kind": { "const": "windows-package-inventory" } } }
      ]
    }
  }
}
