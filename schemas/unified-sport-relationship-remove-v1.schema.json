{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/unified-sport-relationship-remove-v1.schema.json",
  "title": "FitFreed unified sport relationship remove command version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedSnapshotRef", "relationshipRef", "expectedRevision"],
  "properties": {
    "expectedSnapshotRef": {
      "type": "string",
      "pattern": "^training-snapshot-[0-9a-f]{64}$"
    },
    "relationshipRef": {
      "type": "string",
      "pattern": "^unified:sport-[0-9a-f]{64}$"
    },
    "expectedRevision": { "type": "integer", "minimum": 1 }
  }
}
