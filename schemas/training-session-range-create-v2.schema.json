{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-range-create-v2.schema.json",
  "title": "FitFreed training-session range creation version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "snapshotRef", "exerciseRef", "title", "startedAtElapsedMilliseconds", "endedAtElapsedMilliseconds"],
  "properties": {
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "exerciseRef": { "type": "string", "pattern": "^exercise-[0-9a-f]{64}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "startedAtElapsedMilliseconds": { "$ref": "#/$defs/elapsedMilliseconds" },
    "endedAtElapsedMilliseconds": { "$ref": "#/$defs/positiveMilliseconds" }
  },
  "$defs": {
    "elapsedMilliseconds": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveMilliseconds": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
