{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/upgrade-matrix-v1.schema.json",
  "title": "FitFreed upgrade matrix version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "release",
    "supportedApplicationBaselines",
    "supportedLibrarySchemaVersions"
  ],
  "properties": {
    "format": { "const": "org.fitfreed.upgrade-matrix" },
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "librarySchemaVersion"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "librarySchemaVersion": { "$ref": "#/$defs/librarySchemaVersion" }
      }
    },
    "supportedApplicationBaselines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "targets", "librarySchemaVersions"],
        "properties": {
          "version": { "$ref": "#/$defs/semver" },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["darwin-aarch64", "darwin-x86_64"]
            }
          },
          "librarySchemaVersions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/librarySchemaVersion" }
          }
        }
      }
    },
    "supportedLibrarySchemaVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/librarySchemaVersion" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "librarySchemaVersion": {
      "type": "integer",
      "minimum": 1
    }
  }
}
