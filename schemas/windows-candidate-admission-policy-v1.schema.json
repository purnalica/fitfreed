{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/windows-candidate-admission-policy-v1.schema.json",
  "title": "FitFreed Windows candidate admission policy version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "reviewedAt", "sources", "releases"],
  "properties": {
    "format": { "const": "org.fitfreed.windows-candidate-admission-policy" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^https://learn\\.microsoft\\.com/"
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayVersion", "build", "supportEndsOn", "editionIds"],
      "properties": {
        "displayVersion": {
          "type": "string",
          "pattern": "^[0-9]{2}H[12]$"
        },
        "build": {
          "type": "integer",
          "minimum": 22000,
          "maximum": 9007199254740991
        },
        "supportEndsOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "editionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9]+$"
          }
        }
      }
    }
  }
}
