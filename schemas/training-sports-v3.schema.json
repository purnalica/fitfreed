{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-sports-v3.schema.json",
  "title": "FitFreed training sports version 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["originCount", "sessionCount", "sports"],
  "properties": {
    "originCount": { "type": "integer", "minimum": 0 },
    "sessionCount": { "type": "integer", "minimum": 0 },
    "sports": {
      "type": "array",
      "items": { "$ref": "#/$defs/sport" }
    }
  },
  "$defs": {
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "unsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionCount",
        "totalDurationMilliseconds",
        "distanceSessionCount",
        "heartRateSessionCount"
      ],
      "properties": {
        "sessionCount": { "type": "integer", "minimum": 1 },
        "totalDurationMilliseconds": { "$ref": "#/$defs/unsignedDecimal" },
        "distanceSessionCount": { "type": "integer", "minimum": 0 },
        "heartRateSessionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "sport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionFilterRef",
        "sportRef",
        "sourceIndex",
        "state",
        "classification",
        "recognition",
        "recognitionCandidateCount",
        "firstLocalDate",
        "lastLocalDate",
        "coverage"
      ],
      "properties": {
        "sessionFilterRef": {
          "type": "string",
          "pattern": "^sport-[0-9a-f]{64}$"
        },
        "sportRef": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "training-sport-identity-v2.schema.json#/$defs/sportRef" }
          ]
        },
        "sourceIndex": { "type": "integer", "minimum": 1 },
        "state": {
          "enum": [
            "recognized",
            "ambiguous",
            "unknown",
            "personally-overridden",
            "unavailable"
          ]
        },
        "classification": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "training-sport-identity-v2.schema.json#/$defs/unresolvedClassification" },
            { "$ref": "training-sport-identity-v2.schema.json#/$defs/personalClassification" }
          ]
        },
        "recognition": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "training-sport-identity-v2.schema.json#/$defs/recognition" }
          ]
        },
        "recognitionCandidateCount": { "type": "integer", "minimum": 0 },
        "firstLocalDate": { "$ref": "#/$defs/localDate" },
        "lastLocalDate": { "$ref": "#/$defs/localDate" },
        "coverage": { "$ref": "#/$defs/coverage" }
      },
      "oneOf": [
        {
          "properties": {
            "sportRef": { "$ref": "training-sport-identity-v2.schema.json#/$defs/optionalSportRef" },
            "state": { "const": "recognized" },
            "classification": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "training-sport-identity-v2.schema.json#/$defs/unresolvedClassification" }
              ]
            },
            "recognition": { "$ref": "training-sport-identity-v2.schema.json#/$defs/recognition" },
            "recognitionCandidateCount": { "const": 1 }
          },
          "oneOf": [
            {
              "properties": {
                "sportRef": { "$ref": "training-sport-identity-v2.schema.json#/$defs/sportRef" },
                "classification": { "$ref": "training-sport-identity-v2.schema.json#/$defs/unresolvedClassification" }
              }
            },
            {
              "properties": {
                "sportRef": { "type": "null" },
                "classification": { "type": "null" }
              }
            }
          ]
        },
        {
          "properties": {
            "sportRef": { "$ref": "training-sport-identity-v2.schema.json#/$defs/optionalSportRef" },
            "state": { "const": "ambiguous" },
            "classification": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "training-sport-identity-v2.schema.json#/$defs/unresolvedClassification" }
              ]
            },
            "recognition": { "type": "null" },
            "recognitionCandidateCount": { "type": "integer", "minimum": 2 }
          },
          "oneOf": [
            {
              "properties": {
                "sportRef": { "$ref": "training-sport-identity-v2.schema.json#/$defs/sportRef" },
                "classification": { "$ref": "training-sport-identity-v2.schema.json#/$defs/unresolvedClassification" }
              }
            },
            {
              "properties": {
                "sportRef": { "type": "null" },
                "classification": { "type": "null" }
              }
            }
          ]
        },
        {
          "properties": {
            "sportRef": { "$ref": "training-sport-identity-v2.schema.json#/$defs/sportRef" },
            "state": { "const": "unknown" },
            "classification": { "$ref": "training-sport-identity-v2.schema.json#/$defs/unresolvedClassification" },
            "recognition": { "type": "null" },
            "recognitionCandidateCount": { "const": 0 }
          }
        },
        {
          "properties": {
            "sportRef": { "$ref": "training-sport-identity-v2.schema.json#/$defs/sportRef" },
            "state": { "const": "personally-overridden" },
            "classification": { "$ref": "training-sport-identity-v2.schema.json#/$defs/personalClassification" }
          },
          "oneOf": [
            {
              "properties": {
                "recognition": { "type": "null" },
                "recognitionCandidateCount": { "const": 0 }
              }
            },
            {
              "properties": {
                "recognition": { "$ref": "training-sport-identity-v2.schema.json#/$defs/recognition" },
                "recognitionCandidateCount": { "const": 1 }
              }
            },
            {
              "properties": {
                "recognition": { "type": "null" },
                "recognitionCandidateCount": { "type": "integer", "minimum": 2 }
              }
            }
          ]
        },
        {
          "properties": {
            "sportRef": { "type": "null" },
            "state": { "const": "unavailable" },
            "classification": { "type": "null" },
            "recognition": { "type": "null" },
            "recognitionCandidateCount": { "const": 0 }
          }
        }
      ]
    }
  }
}
