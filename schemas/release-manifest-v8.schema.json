{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v8.schema.json",
  "title": "FitFreed macOS and Linux stable release with public unsigned Windows preview manifest version 8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "release",
    "application",
    "platforms",
    "trust",
    "update",
    "generators",
    "artifacts",
    "provenanceRequirements"
  ],
  "properties": {
    "format": { "const": "org.fitfreed.release-manifest" },
    "schemaVersion": { "const": 8 },
    "release": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v7.schema.json#/properties/release"
    },
    "application": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v7.schema.json#/properties/application"
    },
    "platforms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v6.schema.json#/$defs/macosPlatform" },
        { "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v6.schema.json#/$defs/linuxPlatform" },
        { "$ref": "#/$defs/windowsPreviewPlatform" }
      ],
      "items": false
    },
    "trust": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v7.schema.json#/properties/trust"
    },
    "update": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v7.schema.json#/properties/update"
    },
    "generators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargoCycloneDx",
        "linuxBuildEvidence",
        "linuxPackageInventory",
        "npmCycloneDx",
        "tauri",
        "windowsBuildEvidence",
        "windowsPackageInventory"
      ],
      "properties": {
        "cargoCycloneDx": { "type": "string", "minLength": 1 },
        "linuxBuildEvidence": { "const": "1" },
        "linuxPackageInventory": { "const": "1" },
        "npmCycloneDx": { "type": "string", "minLength": 1 },
        "tauri": { "type": "string", "minLength": 1 },
        "windowsBuildEvidence": { "const": "2" },
        "windowsPackageInventory": { "const": "2" }
      }
    },
    "artifacts": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v7.schema.json#/properties/artifacts"
    },
    "provenanceRequirements": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v7.schema.json#/properties/provenanceRequirements"
    }
  },
  "$defs": {
    "windowsPreviewPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "os",
        "architecture",
        "operatingSystemFamily",
        "supportPolicy",
        "packageFormat",
        "installMode",
        "webviewInstallMode",
        "availability",
        "trust"
      ],
      "properties": {
        "target": { "const": "windows-x86_64-nsis" },
        "os": { "const": "windows" },
        "architecture": { "const": "x86_64" },
        "operatingSystemFamily": { "const": "windows-11" },
        "supportPolicy": { "const": "preview-feedback" },
        "packageFormat": { "const": "nsis" },
        "installMode": { "const": "currentUser" },
        "webviewInstallMode": { "const": "offlineInstaller" },
        "availability": {
          "const": {
            "tier": "preview",
            "exactWindows11Admission": false
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authenticode"],
          "properties": {
            "authenticode": {
              "const": {
                "status": "not-provided",
                "publisherIdentity": "unknown",
                "reason": "unsigned-preview"
              }
            }
          }
        }
      }
    }
  }
}
