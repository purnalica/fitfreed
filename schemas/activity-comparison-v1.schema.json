{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/activity-comparison-v1.schema.json",
  "title": "FitFreed daily activity comparison version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["availableRange", "baselineRange", "comparisonRange", "series"],
  "properties": {
    "availableRange": { "$ref": "#/$defs/optionalRange" },
    "baselineRange": { "$ref": "#/$defs/optionalRange" },
    "comparisonRange": { "$ref": "#/$defs/optionalRange" },
    "series": {
      "type": "array",
      "items": { "$ref": "#/$defs/series" }
    }
  },
  "$defs": {
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": { "$ref": "#/$defs/localDate" },
        "through": { "$ref": "#/$defs/localDate" }
      }
    },
    "optionalRange": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/range" }
      ]
    },
    "decimalStepCount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "signedDecimalStepCount": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "optionalDecimalStepCount": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/decimalStepCount" }
      ]
    },
    "optionalSignedDecimalStepCount": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/signedDecimalStepCount" }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendarDays",
        "observedDays",
        "availableStepDays",
        "unavailableStepDays",
        "missingDays",
        "totalStepCount",
        "averageStepCount"
      ],
      "properties": {
        "calendarDays": { "type": "integer", "minimum": 1, "maximum": 366 },
        "observedDays": { "type": "integer", "minimum": 0, "maximum": 366 },
        "availableStepDays": { "type": "integer", "minimum": 0, "maximum": 366 },
        "unavailableStepDays": { "type": "integer", "minimum": 0, "maximum": 366 },
        "missingDays": { "type": "integer", "minimum": 0, "maximum": 366 },
        "totalStepCount": { "$ref": "#/$defs/optionalDecimalStepCount" },
        "averageStepCount": { "$ref": "#/$defs/optionalDecimalStepCount" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesRef",
        "baseline",
        "comparison",
        "totalStepChange",
        "averageStepChange"
      ],
      "properties": {
        "seriesRef": { "type": "string", "minLength": 1 },
        "baseline": { "$ref": "#/$defs/summary" },
        "comparison": { "$ref": "#/$defs/summary" },
        "totalStepChange": { "$ref": "#/$defs/optionalSignedDecimalStepCount" },
        "averageStepChange": { "$ref": "#/$defs/optionalSignedDecimalStepCount" }
      }
    }
  }
}
