{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-update-v4.schema.json",
  "title": "FitFreed report update version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportRef", "expectedRevision", "title", "locale", "blocks"],
  "properties": {
    "reportRef": { "$ref": "report-definition-v4.schema.json#/$defs/reportRef" },
    "expectedRevision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "title": { "$ref": "report-definition-v4.schema.json#/properties/title" },
    "locale": { "$ref": "report-definition-v4.schema.json#/properties/locale" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/updateBlock" },
      "contains": { "$ref": "session-report-update-v3.schema.json#/$defs/narrativeDraft" },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "updateBlock": {
      "oneOf": [
        { "$ref": "session-report-update-v3.schema.json#/$defs/sessionDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/routeDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/narrativeDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/findingDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/comparisonDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/chartDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/tableDraft" },
        { "$ref": "session-report-update-v3.schema.json#/$defs/coverageDraft" }
      ]
    }
  }
}
