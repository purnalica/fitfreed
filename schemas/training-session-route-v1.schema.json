{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-route-v1.schema.json",
  "title": "FitFreed training-session route overview version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotRef", "sessionRef", "routes"],
  "properties": {
    "snapshotRef": { "$ref": "#/$defs/snapshotRef" },
    "sessionRef": { "$ref": "#/$defs/sessionRef" },
    "routes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assessment" }] }
  },
  "$defs": {
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "exerciseRef": { "type": "string", "pattern": "^exercise-[0-9a-f]{64}$" },
    "routeRef": { "type": "string", "pattern": "^route-[0-9a-f]{64}$" },
    "localDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?$"
    },
    "optionalNumber": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
    "optionalElapsed": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "latitudeDegrees", "longitudeDegrees", "altitudeMeters", "elapsedMilliseconds"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "latitudeDegrees": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitudeDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitudeMeters": { "$ref": "#/$defs/optionalNumber" },
        "elapsedMilliseconds": { "$ref": "#/$defs/optionalElapsed" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeRef", "kind", "startedAtLocal", "pointCount", "altitudePointCount", "elapsedPointCount", "projection", "visualPoints"],
      "properties": {
        "routeRef": { "$ref": "#/$defs/routeRef" },
        "kind": { "enum": ["primary", "transition"] },
        "startedAtLocal": { "$ref": "#/$defs/localDateTime" },
        "pointCount": { "type": "integer", "minimum": 0 },
        "altitudePointCount": { "type": "integer", "minimum": 0 },
        "elapsedPointCount": { "type": "integer", "minimum": 0 },
        "projection": { "const": "source-ordinal-v1" },
        "visualPoints": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/point" } }
      }
    },
    "routeCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "transition"],
      "properties": {
        "primary": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/route" }] },
        "transition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/route" }] }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseRef", "ordinal", "routes"],
      "properties": {
        "exerciseRef": { "$ref": "#/$defs/exerciseRef" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "routes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/routeCollection" }] }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercises"],
      "properties": {
        "exercises": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/exercise" } }
          ]
        }
      }
    }
  }
}
