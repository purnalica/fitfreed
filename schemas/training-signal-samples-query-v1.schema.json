{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-signal-samples-query-v1.schema.json",
  "title": "FitFreed exact training-signal samples query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "signalRef", "snapshotRef", "offset", "limit"],
  "properties": {
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "signalRef": { "type": "string", "pattern": "^signal-[0-9a-f]{64}$" },
    "snapshotRef": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" }
      ]
    },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 250 }
  }
}
