{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/longitudinal-overview-v1.schema.json",
  "title": "FitFreed longitudinal overview version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["availableRange", "selectedRange", "series"],
  "properties": {
    "availableRange": { "$ref": "#/$defs/optionalRange" },
    "selectedRange": { "$ref": "#/$defs/optionalRange" },
    "series": {
      "type": "array",
      "items": { "$ref": "#/$defs/series" }
    }
  },
  "$defs": {
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": { "$ref": "#/$defs/localDate" },
        "through": { "$ref": "#/$defs/localDate" }
      }
    },
    "optionalRange": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/range" }
      ]
    },
    "unsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "optionalUnsignedDecimal": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/unsignedDecimal" }
      ]
    },
    "optionalPositiveDecimal": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/positiveDecimal" }
      ]
    },
    "activityDay": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "stepCount"],
          "properties": {
            "availability": { "const": "available" },
            "stepCount": { "$ref": "#/$defs/unsignedDecimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "stepCount"],
          "properties": {
            "availability": { "enum": ["unavailable", "missing"] },
            "stepCount": { "type": "null" }
          }
        }
      ]
    },
    "trainingDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionCount", "totalDurationMilliseconds"],
      "properties": {
        "sessionCount": { "type": "integer", "minimum": 0 },
        "totalDurationMilliseconds": { "$ref": "#/$defs/unsignedDecimal" }
      }
    },
    "sleepDay": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "asleepMilliseconds"],
          "properties": {
            "availability": { "const": "available" },
            "asleepMilliseconds": { "$ref": "#/$defs/unsignedDecimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "asleepMilliseconds"],
          "properties": {
            "availability": { "const": "missing" },
            "asleepMilliseconds": { "type": "null" }
          }
        }
      ]
    },
    "recoveryDay": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "beatToBeatIntervalMilliseconds",
            "heartRateVariabilityRmssdMilliseconds",
            "breathingIntervalMilliseconds"
          ],
          "properties": {
            "availability": { "const": "available" },
            "beatToBeatIntervalMilliseconds": { "$ref": "#/$defs/positiveDecimal" },
            "heartRateVariabilityRmssdMilliseconds": { "$ref": "#/$defs/optionalUnsignedDecimal" },
            "breathingIntervalMilliseconds": { "$ref": "#/$defs/positiveDecimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "beatToBeatIntervalMilliseconds",
            "heartRateVariabilityRmssdMilliseconds",
            "breathingIntervalMilliseconds"
          ],
          "properties": {
            "availability": { "const": "missing" },
            "beatToBeatIntervalMilliseconds": { "type": "null" },
            "heartRateVariabilityRmssdMilliseconds": { "type": "null" },
            "breathingIntervalMilliseconds": { "type": "null" }
          }
        }
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDate", "activity", "training", "sleep", "recovery"],
      "properties": {
        "localDate": { "$ref": "#/$defs/localDate" },
        "activity": { "$ref": "#/$defs/activityDay" },
        "training": { "$ref": "#/$defs/trainingDay" },
        "sleep": { "$ref": "#/$defs/sleepDay" },
        "recovery": { "$ref": "#/$defs/recoveryDay" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seriesRef", "activity", "training", "sleep", "recovery", "days"],
      "properties": {
        "seriesRef": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "activity": { "$ref": "activity-overview-v2.schema.json#/$defs/summary" },
        "training": { "$ref": "training-overview-v1.schema.json#/$defs/summary" },
        "sleep": { "$ref": "sleep-overview-v1.schema.json#/$defs/summary" },
        "recovery": { "$ref": "recovery-overview-v1.schema.json#/$defs/summary" },
        "days": {
          "type": "array",
          "items": { "$ref": "#/$defs/day" },
          "minItems": 1,
          "maxItems": 366
        }
      }
    }
  }
}
