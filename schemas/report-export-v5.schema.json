{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-export-v5.schema.json",
  "title": "FitFreed report export request version 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportRef", "expectedRevision", "expectedSourceSnapshotRef",
    "includePhysiologicalContext", "routeChoices", "destinationPath"
  ],
  "properties": {
    "reportRef": { "$ref": "report-definition-v5.schema.json#/$defs/reportRef" },
    "expectedRevision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "expectedSourceSnapshotRef": {
      "$ref": "report-definition-v5.schema.json#/$defs/snapshotRef"
    },
    "includePhysiologicalContext": { "type": "boolean" },
    "routeChoices": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockRef", "includeGeometry", "endpointRedactionMeters"],
        "properties": {
          "blockRef": { "$ref": "report-definition-v5.schema.json#/$defs/blockRef" },
          "includeGeometry": { "type": "boolean" },
          "endpointRedactionMeters": {
            "$ref": "report-definition-v4.schema.json#/$defs/endpointRedactionMeters"
          }
        }
      }
    },
    "destinationPath": { "type": "string", "minLength": 1, "maxLength": 32768 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expectedSourceSnapshotRef": {
            "$ref": "report-definition-v5.schema.json#/$defs/plannedSnapshotRef"
          }
        }
      },
      "then": {
        "properties": {
          "includePhysiologicalContext": { "const": false },
          "routeChoices": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
