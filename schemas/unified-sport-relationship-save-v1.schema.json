{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/unified-sport-relationship-save-v1.schema.json",
  "title": "FitFreed unified sport relationship save command version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectedSnapshotRef",
    "expectedRevision",
    "relationshipRef",
    "primarySessionFilterRef",
    "members"
  ],
  "properties": {
    "expectedSnapshotRef": {
      "type": "string",
      "pattern": "^training-snapshot-[0-9a-f]{64}$"
    },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "relationshipRef": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^unified:sport-[0-9a-f]{64}$"
        }
      ]
    },
    "primarySessionFilterRef": {
      "type": "string",
      "pattern": "^sport-[0-9a-f]{64}$"
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionFilterRef", "sessionCount"],
        "properties": {
          "sessionFilterRef": {
            "type": "string",
            "pattern": "^sport-[0-9a-f]{64}$"
          },
          "sessionCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "expectedRevision": { "const": 0 },
        "relationshipRef": { "type": "null" }
      }
    },
    {
      "properties": {
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "relationshipRef": {
          "type": "string",
          "pattern": "^unified:sport-[0-9a-f]{64}$"
        }
      }
    }
  ]
}
