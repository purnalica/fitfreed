{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/planned-training-export-v1.schema.json",
  "title": "FitFreed normalized planned-training export version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "libraryRevision",
    "targets",
    "favoriteSnapshots"
  ],
  "properties": {
    "format": { "const": "org.fitfreed.normalized-planned-training" },
    "schemaVersion": { "const": 1 },
    "libraryRevision": { "$ref": "#/$defs/nonNegativeInteger" },
    "targets": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/target" }
    },
    "favoriteSnapshots": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/favoriteSnapshot" }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*@[1-9][0-9]*$",
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^planned-target-[0-9a-f]{64}$"
    },
    "evidenceRevision": {
      "type": "string",
      "pattern": "^planned-evidence-[0-9a-f]{64}$"
    },
    "exerciseRef": {
      "type": "string",
      "pattern": "^planned-exercise-[0-9a-f]{64}$"
    },
    "phaseRef": {
      "type": "string",
      "pattern": "^planned-phase-[0-9a-f]{64}$"
    },
    "transitionRef": {
      "type": "string",
      "pattern": "^planned-transition-[0-9a-f]{64}$"
    },
    "repeatRef": {
      "type": "string",
      "pattern": "^planned-repeat-[0-9a-f]{64}$"
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^favorite-snapshot-[0-9a-f]{64}$"
    },
    "revisionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRevision", "mappingVersion"],
      "properties": {
        "evidenceRevision": { "$ref": "#/$defs/evidenceRevision" },
        "mappingVersion": { "$ref": "#/$defs/version" }
      }
    },
    "targetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kind", "identity"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["scheduled", "favorite-template"] },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originRef",
        "targetRef",
        "source",
        "currentRevision",
        "reconciliationState",
        "revisions",
        "provenance",
        "conflicts"
      ],
      "properties": {
        "originRef": { "$ref": "#/$defs/nonEmptyString" },
        "targetRef": { "$ref": "#/$defs/targetRef" },
        "source": { "$ref": "#/$defs/targetSource" },
        "currentRevision": { "$ref": "#/$defs/revisionReference" },
        "reconciliationState": { "enum": ["current", "conflicted"] },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/revision" }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/provenance" }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/conflict" }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRevision",
        "mappingVersion",
        "targetKind",
        "scheduledAtLocal",
        "completion",
        "name",
        "description",
        "editability",
        "exercises",
        "mappingCoverage",
        "sourceExportVersion"
      ],
      "properties": {
        "evidenceRevision": { "$ref": "#/$defs/evidenceRevision" },
        "mappingVersion": { "$ref": "#/$defs/version" },
        "targetKind": { "enum": ["scheduled", "favorite-template"] },
        "scheduledAtLocal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?$"
            }
          ]
        },
        "completion": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["pending", "completed"] }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 2000 }
          ]
        },
        "editability": { "enum": ["editable", "non-editable", "unspecified"] },
        "exercises": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/$defs/exercise" }
            }
          ]
        },
        "mappingCoverage": { "$ref": "#/$defs/mappingCoverage" },
        "sourceExportVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "targetKind": { "const": "scheduled" } },
            "required": ["targetKind"]
          },
          "then": {
            "properties": {
              "scheduledAtLocal": { "type": "string" },
              "completion": { "enum": ["pending", "completed"] }
            }
          },
          "else": {
            "properties": {
              "scheduledAtLocal": { "type": "null" },
              "completion": { "type": "null" }
            }
          }
        }
      ]
    },
    "mappingCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "unmappedFieldCount", "unmappedFieldLocators"],
      "properties": {
        "state": { "enum": ["complete", "partial"] },
        "unmappedFieldCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "unmappedFieldLocators": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "complete" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "unmappedFieldCount": { "const": 0 },
              "unmappedFieldLocators": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "unmappedFieldCount": { "$ref": "#/$defs/positiveInteger" },
              "unmappedFieldLocators": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exerciseRef",
        "ordinal",
        "kind",
        "durationGoalMilliseconds",
        "distanceGoalMeters",
        "sport",
        "phases"
      ],
      "properties": {
        "exerciseRef": { "$ref": "#/$defs/exerciseRef" },
        "ordinal": { "$ref": "#/$defs/nonNegativeInteger" },
        "kind": { "enum": ["open", "phased", "volume", "strength", "unmapped"] },
        "durationGoalMilliseconds": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positiveInteger" }
          ]
        },
        "distanceGoalMeters": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "exclusiveMinimum": 0 }
          ]
        },
        "sport": { "$ref": "#/$defs/sport" },
        "phases": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "maxItems": 20,
              "items": { "$ref": "#/$defs/phase" }
            }
          ]
        }
      }
    },
    "sport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "suggestion", "sourceEvidence"],
      "properties": {
        "state": { "enum": ["unavailable", "unmapped", "recognized"] },
        "suggestion": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sportSuggestion" }
          ]
        },
        "sourceEvidence": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/sourceSportEvidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "recognized" } },
            "required": ["state"]
          },
          "then": {
            "properties": { "suggestion": { "$ref": "#/$defs/sportSuggestion" } }
          },
          "else": {
            "properties": { "suggestion": { "type": "null" } }
          }
        }
      ]
    },
    "sportSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalFamily", "localizedNames", "provenance"],
      "properties": {
        "canonicalFamily": {
          "oneOf": [
            { "type": "null" },
            {
              "enum": [
                "running",
                "cycling",
                "swimming",
                "walking",
                "hiking",
                "strength",
                "mobility",
                "racket-sport",
                "team-sport",
                "winter-sport",
                "water-sport",
                "other"
              ]
            }
          ]
        },
        "localizedNames": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1000,
          "propertyNames": { "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "provenance": { "$ref": "#/$defs/sportRecognitionProvenance" }
      }
    },
    "sportRecognitionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogueRevision", "retrievedAtUtc", "mappingVersion", "evidenceRef"],
      "properties": {
        "catalogueRevision": { "$ref": "#/$defs/nonEmptyString" },
        "retrievedAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "mappingVersion": { "$ref": "#/$defs/version" },
        "evidenceRef": {
          "type": "string",
          "pattern": "^sport-evidence-[0-9a-f]{64}$"
        }
      }
    },
    "sourceSportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourceCode", "sourceRecordLocator"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "sourceCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceRecordLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseRef", "ordinal", "name", "goal", "intensity", "transition"],
      "properties": {
        "phaseRef": { "$ref": "#/$defs/phaseRef" },
        "ordinal": { "$ref": "#/$defs/nonNegativeInteger" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "goal": { "$ref": "#/$defs/phaseGoal" },
        "intensity": { "$ref": "#/$defs/intensity" },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "phaseGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "durationMilliseconds", "distanceMeters"],
      "properties": {
        "kind": { "enum": ["duration", "distance", "unmapped"] },
        "durationMilliseconds": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positiveInteger" }
          ]
        },
        "distanceMeters": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "exclusiveMinimum": 0 }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "duration" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "durationMilliseconds": { "$ref": "#/$defs/positiveInteger" },
              "distanceMeters": { "type": "null" }
            }
          },
          "else": {
            "if": {
              "properties": { "kind": { "const": "distance" } },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "durationMilliseconds": { "type": "null" },
                "distanceMeters": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "else": {
              "properties": {
                "durationMilliseconds": { "type": "null" },
                "distanceMeters": { "type": "null" }
              }
            }
          }
        }
      ]
    },
    "intensity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "metric", "lowerZone", "upperZone"],
      "properties": {
        "kind": { "enum": ["none", "zone-range", "unmapped"] },
        "metric": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["heart-rate", "speed", "power"] }
          ]
        },
        "lowerZone": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 5 }
          ]
        },
        "upperZone": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 5 }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "zone-range" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "metric": { "enum": ["heart-rate", "speed", "power"] },
              "lowerZone": { "type": "integer", "minimum": 1, "maximum": 5 },
              "upperZone": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          },
          "else": {
            "properties": {
              "metric": { "type": "null" },
              "lowerZone": { "type": "null" },
              "upperZone": { "type": "null" }
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitionRef", "change", "repeat"],
      "properties": {
        "transitionRef": { "$ref": "#/$defs/transitionRef" },
        "change": { "enum": ["manual", "automatic", "unmapped"] },
        "repeat": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/repeat" }
          ]
        }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeatRef", "returnToPhaseOrdinal", "totalIterations"],
      "properties": {
        "repeatRef": { "$ref": "#/$defs/repeatRef" },
        "returnToPhaseOrdinal": { "$ref": "#/$defs/nonNegativeInteger" },
        "totalIterations": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRef",
        "sourceProvider",
        "sourceAdapterVersion",
        "mappingVersion",
        "sourceIdentity",
        "sourceArtifactLocator",
        "sourceArtifactSha256",
        "sourceRecordLocator",
        "sourceExportVersion",
        "reconciliationDecision",
        "contributesToVisibleState"
      ],
      "properties": {
        "operationRef": { "$ref": "#/$defs/nonEmptyString" },
        "sourceProvider": { "$ref": "#/$defs/nonEmptyString" },
        "sourceAdapterVersion": { "$ref": "#/$defs/version" },
        "mappingVersion": { "$ref": "#/$defs/version" },
        "sourceIdentity": { "$ref": "#/$defs/nonEmptyString" },
        "sourceArtifactLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "sourceRecordLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceExportVersion": { "$ref": "#/$defs/nonEmptyString" },
        "reconciliationDecision": {
          "enum": ["create", "equivalent", "enrich", "amend", "preserve", "conflict"]
        },
        "contributesToVisibleState": { "type": "boolean" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRef",
        "existingRevision",
        "incomingRevision",
        "sourceArtifactLocator"
      ],
      "properties": {
        "operationRef": { "$ref": "#/$defs/nonEmptyString" },
        "existingRevision": { "$ref": "#/$defs/revisionReference" },
        "incomingRevision": { "$ref": "#/$defs/revisionReference" },
        "sourceArtifactLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "favoriteSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originRef",
        "snapshotRef",
        "sourceProvider",
        "sourceAdapterVersion",
        "mappingVersion",
        "sourceArtifactLocator",
        "sourceArtifactSha256",
        "operationRef",
        "current",
        "members"
      ],
      "properties": {
        "originRef": { "$ref": "#/$defs/nonEmptyString" },
        "snapshotRef": { "$ref": "#/$defs/snapshotRef" },
        "sourceProvider": { "$ref": "#/$defs/nonEmptyString" },
        "sourceAdapterVersion": { "$ref": "#/$defs/version" },
        "mappingVersion": { "$ref": "#/$defs/version" },
        "sourceArtifactLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "operationRef": { "$ref": "#/$defs/nonEmptyString" },
        "current": { "type": "boolean" },
        "members": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/favoriteMember" }
        }
      }
    },
    "favoriteMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "targetRef", "evidenceRevision", "mappingVersion"],
      "properties": {
        "ordinal": { "$ref": "#/$defs/nonNegativeInteger" },
        "targetRef": { "$ref": "#/$defs/targetRef" },
        "evidenceRevision": { "$ref": "#/$defs/evidenceRevision" },
        "mappingVersion": { "$ref": "#/$defs/version" }
      }
    }
  }
}
