{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/library-home-v9.schema.json",
  "title": "FitFreed library home version 9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "libraryRevisionRef",
    "recordedRange",
    "usableRange",
    "primaryRange",
    "domains",
    "questions",
    "training",
    "highlight",
    "postImport",
    "resumableExploration"
  ],
  "properties": {
    "version": { "const": 9 },
    "libraryRevisionRef": { "$ref": "library-home-v8.schema.json#/properties/libraryRevisionRef" },
    "recordedRange": { "$ref": "library-home-v8.schema.json#/properties/recordedRange" },
    "usableRange": { "$ref": "library-home-v8.schema.json#/properties/usableRange" },
    "primaryRange": { "$ref": "library-home-v8.schema.json#/properties/primaryRange" },
    "domains": { "$ref": "library-home-v8.schema.json#/properties/domains" },
    "questions": { "$ref": "library-home-v8.schema.json#/properties/questions" },
    "training": { "$ref": "library-home-v8.schema.json#/properties/training" },
    "highlight": { "$ref": "library-home-v8.schema.json#/properties/highlight" },
    "postImport": { "$ref": "library-home-v8.schema.json#/properties/postImport" },
    "resumableExploration": { "$ref": "library-home-v8.schema.json#/properties/resumableExploration" }
  }
}
