{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-library-v4.schema.json",
  "title": "FitFreed result-first report library version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "totalCount", "offset", "limit", "nextOffset"],
  "properties": {
    "items": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/item" } },
    "totalCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 24 },
    "nextOffset": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 1000 }
      ]
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportRef", "title", "locale", "sourceSnapshotRef", "revision",
        "evidenceState", "subject", "period", "result", "sensitivity"
      ],
      "properties": {
        "reportRef": { "$ref": "report-definition-v5.schema.json#/$defs/reportRef" },
        "title": { "$ref": "report-definition-v5.schema.json#/properties/title" },
        "locale": { "$ref": "report-definition-v5.schema.json#/properties/locale" },
        "sourceSnapshotRef": { "$ref": "report-definition-v5.schema.json#/$defs/snapshotRef" },
        "revision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "evidenceState": { "enum": ["current", "stale", "unavailable", "authored-only"] },
        "subject": { "$ref": "#/$defs/subject" },
        "period": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "report-library-v3.schema.json#/$defs/sessionPeriod" },
            { "$ref": "report-library-v3.schema.json#/$defs/comparisonPeriod" },
            { "$ref": "#/$defs/plannedPeriod" }
          ]
        },
        "result": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "report-library-v3.schema.json#/$defs/sessionResult" },
            { "$ref": "report-library-v3.schema.json#/$defs/comparisonResult" },
            { "$ref": "#/$defs/plannedResult" }
          ]
        },
        "sensitivity": { "$ref": "report-library-v3.schema.json#/$defs/sensitivity" }
      }
    },
    "subject": {
      "oneOf": [
        { "$ref": "report-library-v3.schema.json#/$defs/subject" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "planned-training" },
            "name": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "minLength": 1, "maxLength": 500 }
              ]
            }
          }
        }
      ]
    },
    "plannedPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scheduledAtLocal"],
      "properties": {
        "kind": { "const": "planned-training" },
        "scheduledAtLocal": {
          "$ref": "planned-training-chronology-v1.schema.json#/$defs/localDateTime"
        }
      }
    },
    "optionalCount": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "plannedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "exerciseCount", "phaseCount", "expandedPhaseCount",
        "repeatBlockCount"
      ],
      "properties": {
        "kind": { "const": "planned-training" },
        "exerciseCount": { "$ref": "#/$defs/optionalCount" },
        "phaseCount": { "$ref": "#/$defs/optionalCount" },
        "expandedPhaseCount": { "$ref": "#/$defs/optionalCount" },
        "repeatBlockCount": { "$ref": "#/$defs/optionalCount" }
      }
    }
  }
}
