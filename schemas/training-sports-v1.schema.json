{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-sports-v1.schema.json",
  "title": "FitFreed training sports version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["originCount", "sessionCount", "sports"],
  "properties": {
    "originCount": { "type": "integer", "minimum": 0 },
    "sessionCount": { "type": "integer", "minimum": 0 },
    "sports": {
      "type": "array",
      "items": { "$ref": "#/$defs/sport" }
    }
  },
  "$defs": {
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "unsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "family": {
      "enum": [
        "running",
        "cycling",
        "swimming",
        "walking",
        "hiking",
        "strength",
        "mobility",
        "racket-sport",
        "team-sport",
        "winter-sport",
        "water-sport",
        "other"
      ]
    },
    "optionalFamily": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/family" }
      ]
    },
    "displayLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?=\\S)(?:(?![\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S])*\\S$"
    },
    "optionalDisplayLabel": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/displayLabel" }
      ]
    },
    "unresolvedClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalFamily", "displayLabel", "authorship", "revision"],
      "properties": {
        "canonicalFamily": { "type": "null" },
        "displayLabel": { "type": "null" },
        "authorship": { "type": "null" },
        "revision": { "const": 0 }
      }
    },
    "authoredUnknownClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalFamily", "displayLabel", "authorship", "revision"],
      "properties": {
        "canonicalFamily": { "type": "null" },
        "displayLabel": { "type": "null" },
        "authorship": { "const": "user" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "classifiedClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalFamily", "displayLabel", "authorship", "revision"],
      "properties": {
        "canonicalFamily": { "$ref": "#/$defs/optionalFamily" },
        "displayLabel": { "$ref": "#/$defs/optionalDisplayLabel" },
        "authorship": { "const": "user" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "properties": { "canonicalFamily": { "$ref": "#/$defs/family" } } },
        { "properties": { "displayLabel": { "$ref": "#/$defs/displayLabel" } } }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionCount",
        "totalDurationMilliseconds",
        "distanceSessionCount",
        "heartRateSessionCount"
      ],
      "properties": {
        "sessionCount": { "type": "integer", "minimum": 1 },
        "totalDurationMilliseconds": { "$ref": "#/$defs/unsignedDecimal" },
        "distanceSessionCount": { "type": "integer", "minimum": 0 },
        "heartRateSessionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "commonSport": {
      "type": "object",
      "required": [
        "sportRef",
        "sourceIndex",
        "state",
        "classification",
        "firstLocalDate",
        "lastLocalDate",
        "coverage"
      ],
      "properties": {
        "sportRef": true,
        "sourceIndex": { "type": "integer", "minimum": 1 },
        "state": true,
        "classification": true,
        "firstLocalDate": { "$ref": "#/$defs/localDate" },
        "lastLocalDate": { "$ref": "#/$defs/localDate" },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "unknownSport": {
      "allOf": [
        { "$ref": "#/$defs/commonSport" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sportRef",
            "sourceIndex",
            "state",
            "classification",
            "firstLocalDate",
            "lastLocalDate",
            "coverage"
          ],
          "properties": {
            "sportRef": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sourceIndex": true,
            "state": { "const": "unknown" },
            "classification": {
              "oneOf": [
                { "$ref": "#/$defs/unresolvedClassification" },
                { "$ref": "#/$defs/authoredUnknownClassification" }
              ]
            },
            "firstLocalDate": true,
            "lastLocalDate": true,
            "coverage": true
          }
        }
      ]
    },
    "classifiedSport": {
      "allOf": [
        { "$ref": "#/$defs/commonSport" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sportRef",
            "sourceIndex",
            "state",
            "classification",
            "firstLocalDate",
            "lastLocalDate",
            "coverage"
          ],
          "properties": {
            "sportRef": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sourceIndex": true,
            "state": { "const": "classified" },
            "classification": { "$ref": "#/$defs/classifiedClassification" },
            "firstLocalDate": true,
            "lastLocalDate": true,
            "coverage": true
          }
        }
      ]
    },
    "unavailableSport": {
      "allOf": [
        { "$ref": "#/$defs/commonSport" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sportRef",
            "sourceIndex",
            "state",
            "classification",
            "firstLocalDate",
            "lastLocalDate",
            "coverage"
          ],
          "properties": {
            "sportRef": { "type": "null" },
            "sourceIndex": true,
            "state": { "const": "unavailable" },
            "classification": { "type": "null" },
            "firstLocalDate": true,
            "lastLocalDate": true,
            "coverage": true
          }
        }
      ]
    },
    "sport": {
      "oneOf": [
        { "$ref": "#/$defs/unknownSport" },
        { "$ref": "#/$defs/classifiedSport" },
        { "$ref": "#/$defs/unavailableSport" }
      ]
    }
  }
}
