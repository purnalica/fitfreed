{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-segment-criterion-mutation-v1.schema.json",
  "title": "FitFreed training segment criterion association mutation version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "snapshotRef", "exerciseRef", "criterionRef"],
  "properties": {
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "exerciseRef": { "type": "string", "pattern": "^exercise-[0-9a-f]{64}$" },
    "criterionRef": { "type": "string", "pattern": "^criterion-[0-9a-f]{64}$" }
  }
}
