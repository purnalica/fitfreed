{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/session-report-create-v2.schema.json",
  "title": "FitFreed composed session report creation version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "locale", "sessionRef", "sourceSnapshotRef", "blocks"],
  "properties": {
    "title": { "$ref": "report-definition-v2.schema.json#/properties/title" },
    "locale": { "$ref": "report-definition-v2.schema.json#/properties/locale" },
    "sessionRef": { "$ref": "report-definition-v2.schema.json#/$defs/sessionRef" },
    "sourceSnapshotRef": { "$ref": "report-definition-v2.schema.json#/$defs/snapshotRef" },
    "blocks": { "$ref": "#/$defs/draftBlocks" }
  },
  "$defs": {
    "sessionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "includePhysiologicalContext"],
      "properties": {
        "kind": { "const": "session-evidence" },
        "includePhysiologicalContext": { "type": "boolean" }
      }
    },
    "routeDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "routeRef", "endpointRedactionMeters"],
      "properties": {
        "kind": { "const": "route" },
        "routeRef": { "$ref": "report-definition-v2.schema.json#/$defs/routeRef" },
        "endpointRedactionMeters": {
          "$ref": "report-definition-v2.schema.json#/$defs/endpointRedactionMeters"
        }
      }
    },
    "narrativeDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": { "const": "narrative" },
        "body": { "$ref": "report-definition-v2.schema.json#/$defs/narrativeBlock/properties/body" }
      }
    },
    "draftBlocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/sessionDraft" },
          { "$ref": "#/$defs/routeDraft" },
          { "$ref": "#/$defs/narrativeDraft" }
        ]
      },
      "allOf": [
        {
          "contains": { "$ref": "#/$defs/sessionDraft" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/narrativeDraft" },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
