{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/library-home-query-v1.schema.json",
  "title": "FitFreed library home query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["afterImportOperationRef"],
  "properties": {
    "afterImportOperationRef": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" }
      ]
    }
  }
}
