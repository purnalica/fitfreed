{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/source-acquisition-guide-v1.schema.json",
  "title": "FitFreed source acquisition guide version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "guideVersion",
    "verifiedOn",
    "expectedArchive",
    "instructionKeys",
    "constraintKeys",
    "troubleshootingKeys",
    "officialLinks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "guideVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]*$",
      "maxLength": 96
    },
    "verifiedOn": { "type": "string", "format": "date" },
    "expectedArchive": { "const": "zip" },
    "instructionKeys": {
      "type": "array",
      "$ref": "#/$defs/requiredContentKeys",
      "maxItems": 32
    },
    "constraintKeys": {
      "type": "array",
      "$ref": "#/$defs/contentKeys",
      "maxItems": 16
    },
    "troubleshootingKeys": {
      "type": "array",
      "$ref": "#/$defs/requiredContentKeys",
      "maxItems": 16
    },
    "officialLinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/officialLink" },
      "contains": {
        "type": "object",
        "required": ["purpose"],
        "properties": {
          "purpose": { "const": "instructions" }
        }
      }
    }
  },
  "$defs": {
    "contentKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "contentKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contentKey" }
    },
    "requiredContentKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contentKey" }
    },
    "officialLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "locale", "url"],
      "properties": {
        "purpose": { "enum": ["account", "instructions"] },
        "locale": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    }
  }
}
