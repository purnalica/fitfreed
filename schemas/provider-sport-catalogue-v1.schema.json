{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/provider-sport-catalogue-v1.schema.json",
  "title": "FitFreed provider sport catalogue evidence version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceProvider",
    "catalogueRevision",
    "retrievedAtUtc",
    "provenanceUri",
    "provenanceSha256",
    "mappingVersion",
    "entries"
  ],
  "properties": {
    "sourceProvider": { "$ref": "#/$defs/provider" },
    "catalogueRevision": { "$ref": "#/$defs/revision" },
    "retrievedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "minLength": 20,
      "maxLength": 64
    },
    "provenanceUri": { "$ref": "#/$defs/provenanceUri" },
    "provenanceSha256": { "$ref": "#/$defs/sha256" },
    "mappingVersion": { "$ref": "#/$defs/revision" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "canonicalText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=\\S)(?:(?![\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S])*\\S$"
    },
    "provider": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "type": "string", "maxLength": 128 }
      ]
    },
    "revision": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "type": "string", "maxLength": 256 }
      ]
    },
    "identifier": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "type": "string", "maxLength": 256 }
      ]
    },
    "provenanceUri": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "type": "string", "format": "uri", "maxLength": 2048 }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "family": {
      "enum": [
        "running",
        "cycling",
        "swimming",
        "walking",
        "hiking",
        "strength",
        "mobility",
        "racket-sport",
        "team-sport",
        "winter-sport",
        "water-sport",
        "other"
      ]
    },
    "localizedNames": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/canonicalText" },
          { "type": "string", "maxLength": 120 }
        ]
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIdentifier",
        "providerNameKey",
        "localizedNames",
        "parentIdentifier",
        "canonicalFamilySuggestion"
      ],
      "properties": {
        "sourceIdentifier": { "$ref": "#/$defs/identifier" },
        "providerNameKey": { "$ref": "#/$defs/identifier" },
        "localizedNames": { "$ref": "#/$defs/localizedNames" },
        "parentIdentifier": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "canonicalFamilySuggestion": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/family" }
          ]
        }
      }
    }
  }
}
