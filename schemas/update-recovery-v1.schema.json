{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/update-recovery-v1.schema.json",
  "title": "FitFreed update recovery manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "recoveryId",
    "phase",
    "preparedAt",
    "replacementProcess",
    "source",
    "target",
    "applicationBackup",
    "libraryBackup"
  ],
  "properties": {
    "format": { "const": "org.fitfreed.update-recovery" },
    "schemaVersion": { "const": 1 },
    "recoveryId": { "$ref": "#/$defs/sha256" },
    "phase": {
      "enum": [
        "prepared",
        "replacement-started",
        "replacement-installed",
        "launching",
        "confirmed",
        "recovering",
        "recovered",
        "recovery-failed"
      ]
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "maxLength": 20
    },
    "replacementProcess": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processId",
            "startedAtUnixSeconds",
            "startedAtMicroseconds",
            "launchNonce",
            "confirmationDeadline"
          ],
          "properties": {
            "processId": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2147483647
            },
            "startedAtUnixSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "startedAtMicroseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "launchNonce": { "$ref": "#/$defs/sha256" },
            "confirmationDeadline": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "maxLength": 20
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "librarySchemaVersion",
        "applicationPath",
        "libraryPath"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "librarySchemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "applicationPath": { "$ref": "#/$defs/absolutePath" },
        "libraryPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "librarySchemaVersion",
        "trustedSequence",
        "trustedPayloadSha256",
        "packageSha256"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "librarySchemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "trustedSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "trustedPayloadSha256": { "$ref": "#/$defs/sha256" },
        "packageSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "applicationBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "treeSha256"],
      "properties": {
        "relativePath": { "const": "previous/FitFreed.app" },
        "treeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "libraryBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sizeBytes", "sha256"],
      "properties": {
        "relativePath": { "const": "previous/fitfreed.sqlite" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "semver": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
