{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-calendar-v2.schema.json",
  "title": "FitFreed training-session calendar version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["availableRange", "snapshotRef", "month", "days"],
  "properties": {
    "availableRange": {
      "$ref": "training-session-search-v4.schema.json#/$defs/optionalRange"
    },
    "snapshotRef": {
      "$ref": "training-session-search-v4.schema.json#/$defs/snapshotRef"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "days": {
      "type": "array",
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "unsignedIntegerString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionRef",
        "startedAtLocal",
        "durationMilliseconds",
        "sport"
      ],
      "properties": {
        "sessionRef": {
          "$ref": "training-session-search-v4.schema.json#/$defs/sessionRef"
        },
        "startedAtLocal": {
          "$ref": "training-session-search-v4.schema.json#/$defs/localDateTime"
        },
        "durationMilliseconds": { "$ref": "#/$defs/unsignedIntegerString" },
        "sport": {
          "$ref": "training-sport-identity-v3.schema.json#/$defs/sportIdentity"
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localDate",
        "sourceIndex",
        "sessionCount",
        "totalDurationMilliseconds",
        "distanceSessionCount",
        "totalDistanceMeters",
        "heartRateSessionCount",
        "activities"
      ],
      "properties": {
        "localDate": {
          "$ref": "training-session-search-v4.schema.json#/$defs/localDate"
        },
        "sourceIndex": { "type": "integer", "minimum": 1 },
        "sessionCount": { "type": "integer", "minimum": 1 },
        "totalDurationMilliseconds": { "$ref": "#/$defs/unsignedIntegerString" },
        "distanceSessionCount": { "type": "integer", "minimum": 0 },
        "totalDistanceMeters": {
          "$ref": "training-session-search-v4.schema.json#/$defs/optionalDistance"
        },
        "heartRateSessionCount": { "type": "integer", "minimum": 0 },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/activity" }
        }
      }
    }
  }
}
