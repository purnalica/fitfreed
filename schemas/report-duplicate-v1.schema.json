{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-duplicate-v1.schema.json",
  "title": "FitFreed report duplication version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceReportRef", "expectedSourceRevision", "title"],
  "properties": {
    "sourceReportRef": { "$ref": "report-definition-v5.schema.json#/$defs/reportRef" },
    "expectedSourceRevision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "title": { "$ref": "report-definition-v5.schema.json#/properties/title" }
  }
}
