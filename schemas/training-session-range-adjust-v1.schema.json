{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-range-adjust-v1.schema.json",
  "title": "FitFreed training-session range adjustment version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "snapshotRef", "rangeRef", "expectedRevision", "startedAtElapsedMilliseconds", "endedAtElapsedMilliseconds"],
  "properties": {
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "rangeRef": { "type": "string", "pattern": "^range-[0-9a-f]{64}$" },
    "expectedRevision": { "type": "integer", "minimum": 1 },
    "startedAtElapsedMilliseconds": { "$ref": "#/$defs/elapsedMilliseconds" },
    "endedAtElapsedMilliseconds": { "$ref": "#/$defs/positiveMilliseconds" }
  },
  "$defs": {
    "elapsedMilliseconds": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveMilliseconds": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
