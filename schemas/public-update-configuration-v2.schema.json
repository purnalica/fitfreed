{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/public-update-configuration-v2.schema.json",
  "title": "FitFreed public update build configuration version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "status",
    "contract",
    "metadataEndpoint",
    "keys"
  ],
  "properties": {
    "format": { "const": "org.fitfreed.public-update-configuration" },
    "schemaVersion": { "const": 2 },
    "status": { "enum": ["inactive", "active"] },
    "contract": { "const": "stable-v3" },
    "metadataEndpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "keys": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publicKey"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "publicKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16384,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "inactive" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "keys": { "type": "array", "maxItems": 0 } }
      },
      "else": {
        "properties": { "keys": { "type": "array", "minItems": 1 } }
      }
    }
  ]
}
