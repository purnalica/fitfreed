{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/release-manifest-v6.schema.json",
  "title": "FitFreed expanding macOS and Linux public release manifest version 6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "release",
    "application",
    "platforms",
    "trust",
    "update",
    "generators",
    "artifacts",
    "provenanceRequirements"
  ],
  "properties": {
    "format": {
      "const": "org.fitfreed.release-manifest"
    },
    "schemaVersion": {
      "const": 6
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "generatedAt",
        "channel"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "const": "public-stable"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productName",
        "identifier",
        "executable",
        "storageSchemaVersion"
      ],
      "properties": {
        "productName": {
          "const": "FitFreed"
        },
        "identifier": {
          "const": "org.fitfreed.desktop"
        },
        "executable": {
          "const": "fitfreed"
        },
        "storageSchemaVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/macosPlatform"
        },
        {
          "$ref": "#/$defs/linuxPlatform"
        }
      ],
      "items": false
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSignature",
        "updaterSignatures"
      ],
      "properties": {
        "releaseSignature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "keyId",
            "subjectPath",
            "signaturePath"
          ],
          "properties": {
            "algorithm": {
              "const": "minisign-ed25519"
            },
            "keyId": {
              "$ref": "#/$defs/keyId"
            },
            "subjectPath": {
              "const": "SHA256SUMS"
            },
            "signaturePath": {
              "const": "SHA256SUMS.minisig"
            }
          }
        },
        "updaterSignatures": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/macosUpdaterSignature"
            },
            {
              "$ref": "#/$defs/linuxUpdaterSignature"
            }
          ],
          "items": false
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "metadataEndpoint",
        "keyId",
        "sequence",
        "targets"
      ],
      "properties": {
        "contract": {
          "const": "stable-v3"
        },
        "metadataEndpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "keyId": {
          "$ref": "#/$defs/keyId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "targets": {
          "const": [
            "darwin-aarch64",
            "linux-x86_64-deb"
          ]
        }
      }
    },
    "generators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargoCycloneDx",
        "linuxBuildEvidence",
        "linuxPackageInventory",
        "npmCycloneDx",
        "tauri"
      ],
      "properties": {
        "cargoCycloneDx": {
          "type": "string",
          "minLength": 1
        },
        "linuxBuildEvidence": {
          "const": "1"
        },
        "linuxPackageInventory": {
          "const": "1"
        },
        "npmCycloneDx": {
          "type": "string",
          "minLength": 1
        },
        "tauri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 12,
      "allOf": [
        {
          "$ref": "#/$defs/containsMacosApplication"
        },
        {
          "$ref": "#/$defs/containsMacosDiskImage"
        },
        {
          "$ref": "#/$defs/containsMacosUpdater"
        },
        {
          "$ref": "#/$defs/containsMacosUpdaterSignature"
        },
        {
          "$ref": "#/$defs/containsLinuxPackage"
        },
        {
          "$ref": "#/$defs/containsLinuxInventory"
        },
        {
          "$ref": "#/$defs/containsLinuxBuildEvidence"
        },
        {
          "$ref": "#/$defs/containsLinuxUpdaterSignature"
        },
        {
          "$ref": "#/$defs/containsUpdateEnvelope"
        },
        {
          "$ref": "#/$defs/containsSbom"
        },
        {
          "$ref": "#/$defs/containsUpgradeMatrix"
        },
        {
          "$ref": "#/$defs/containsReleaseNotes"
        }
      ],
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "provenanceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "digestBoundSubjects",
        "generatedSubjects"
      ],
      "properties": {
        "provider": {
          "const": "github-artifact-attestations"
        },
        "digestBoundSubjects": {
          "type": "array",
          "minItems": 11,
          "items": {
            "$ref": "#/$defs/provenanceSubject"
          }
        },
        "generatedSubjects": {
          "const": [
            "release-manifest.json",
            "SHA256SUMS",
            "SHA256SUMS.minisig"
          ]
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[^/\\\\]+$",
      "maxLength": 255
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "macosPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "os",
        "architecture",
        "minimumSystemVersion",
        "trust"
      ],
      "properties": {
        "target": {
          "const": "darwin-aarch64"
        },
        "os": {
          "const": "macos"
        },
        "architecture": {
          "const": "aarch64"
        },
        "minimumSystemVersion": {
          "const": "15.0"
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codeSigning",
            "notarization"
          ],
          "properties": {
            "codeSigning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "certificateSha256",
                "teamIdentifier",
                "hardenedRuntime",
                "secureTimestamp"
              ],
              "properties": {
                "identity": {
                  "const": "developer-id-application"
                },
                "certificateSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "teamIdentifier": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{10}$"
                },
                "hardenedRuntime": {
                  "const": true
                },
                "secureTimestamp": {
                  "const": true
                }
              }
            },
            "notarization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "service",
                "applicationStapled",
                "diskImageStapled",
                "gatekeeperAccepted"
              ],
              "properties": {
                "service": {
                  "const": "apple-notary-service"
                },
                "applicationStapled": {
                  "const": true
                },
                "diskImageStapled": {
                  "const": true
                },
                "gatekeeperAccepted": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    "linuxPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "os",
        "architecture",
        "packageFormat",
        "supportedDistributions",
        "trust"
      ],
      "properties": {
        "target": {
          "const": "linux-x86_64-deb"
        },
        "os": {
          "const": "linux"
        },
        "architecture": {
          "const": "x86_64"
        },
        "packageFormat": {
          "const": "deb"
        },
        "supportedDistributions": {
          "const": [
            {
              "id": "ubuntu",
              "version": "24.04",
              "edition": "desktop"
            },
            {
              "id": "ubuntu",
              "version": "26.04",
              "edition": "desktop"
            }
          ]
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativePackageIdentity"
          ],
          "properties": {
            "nativePackageIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "not-provided"
                },
                "reason": {
                  "const": "no-selected-linux-platform-signature"
                }
              }
            }
          }
        }
      }
    },
    "updaterSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "algorithm",
        "keyId",
        "subjectPath",
        "signaturePath"
      ],
      "properties": {
        "target": {
          "enum": [
            "darwin-aarch64",
            "linux-x86_64-deb"
          ]
        },
        "algorithm": {
          "const": "minisign-ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/keyId"
        },
        "subjectPath": {
          "$ref": "#/$defs/path"
        },
        "signaturePath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "macosUpdaterSignature": {
      "allOf": [
        {
          "$ref": "#/$defs/updaterSignature"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "const": "darwin-aarch64"
            }
          }
        }
      ]
    },
    "linuxUpdaterSignature": {
      "allOf": [
        {
          "$ref": "#/$defs/updaterSignature"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "const": "linux-x86_64-deb"
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "target",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "macos-application-bundle",
            "macos-disk-image",
            "macos-updater-archive",
            "macos-updater-signature",
            "linux-x86_64-deb",
            "linux-package-inventory",
            "linux-build-evidence",
            "linux-updater-signature",
            "stable-update-envelope",
            "cyclonedx-sbom",
            "upgrade-matrix",
            "release-notes"
          ]
        },
        "target": {
          "enum": [
            "darwin-aarch64",
            "linux-x86_64-deb",
            "release"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenanceSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "containsMacosApplication": {
      "$ref": "#/$defs/containsOneMacosApplication"
    },
    "containsOneMacosApplication": {
      "type": "array",
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "macos-application-bundle"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsMacosDiskImage": {
      "$ref": "#/$defs/containsKindMacosDiskImage"
    },
    "containsKindMacosDiskImage": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "macos-disk-image"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsMacosUpdater": {
      "$ref": "#/$defs/containsKindMacosUpdater"
    },
    "containsKindMacosUpdater": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "macos-updater-archive"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsMacosUpdaterSignature": {
      "$ref": "#/$defs/containsKindMacosUpdaterSignature"
    },
    "containsKindMacosUpdaterSignature": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "macos-updater-signature"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsLinuxPackage": {
      "$ref": "#/$defs/containsKindLinuxPackage"
    },
    "containsKindLinuxPackage": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "linux-x86_64-deb"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsLinuxInventory": {
      "$ref": "#/$defs/containsKindLinuxInventory"
    },
    "containsKindLinuxInventory": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "linux-package-inventory"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsLinuxBuildEvidence": {
      "$ref": "#/$defs/containsKindLinuxBuildEvidence"
    },
    "containsKindLinuxBuildEvidence": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "linux-build-evidence"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsLinuxUpdaterSignature": {
      "$ref": "#/$defs/containsKindLinuxUpdaterSignature"
    },
    "containsKindLinuxUpdaterSignature": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "linux-updater-signature"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsUpdateEnvelope": {
      "$ref": "#/$defs/containsKindUpdateEnvelope"
    },
    "containsKindUpdateEnvelope": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "stable-update-envelope"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsSbom": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "cyclonedx-sbom"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1
    },
    "containsUpgradeMatrix": {
      "$ref": "#/$defs/containsKindUpgradeMatrix"
    },
    "containsKindUpgradeMatrix": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "upgrade-matrix"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "containsReleaseNotes": {
      "$ref": "#/$defs/containsKindReleaseNotes"
    },
    "containsKindReleaseNotes": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "release-notes"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
