{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-route-points-v1.schema.json",
  "title": "FitFreed exact training-route points page version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotRef", "sessionRef", "routeRef", "pointCount", "offset", "points", "nextOffset"],
  "properties": {
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "routeRef": { "type": "string", "pattern": "^route-[0-9a-f]{64}$" },
    "pointCount": { "type": "integer", "minimum": 0 },
    "offset": { "type": "integer", "minimum": 0 },
    "points": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-route-v1.schema.json#/$defs/point" }
    },
    "nextOffset": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
    }
  }
}
