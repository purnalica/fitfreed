{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-create-v5.schema.json",
  "title": "FitFreed report creation version 5",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "locale", "sourceSnapshotRef", "origin", "blocks"],
  "properties": {
    "title": { "$ref": "report-definition-v5.schema.json#/properties/title" },
    "locale": { "$ref": "report-definition-v5.schema.json#/properties/locale" },
    "sourceSnapshotRef": { "$ref": "report-definition-v5.schema.json#/$defs/snapshotRef" },
    "origin": { "$ref": "report-definition-v5.schema.json#/$defs/origin" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/draftBlock" },
      "contains": { "$ref": "session-report-create-v3.schema.json#/$defs/narrativeDraft" },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "type": "object",
            "properties": { "kind": { "const": "planned-training" } }
          }
        }
      },
      "then": {
        "properties": {
          "sourceSnapshotRef": {
            "$ref": "report-definition-v5.schema.json#/$defs/plannedSnapshotRef"
          },
          "blocks": {
            "type": "array",
            "contains": { "$ref": "#/$defs/plannedTrainingDraft" },
            "minContains": 1,
            "maxContains": 1,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/plannedTrainingDraft" },
                { "$ref": "session-report-create-v3.schema.json#/$defs/narrativeDraft" }
              ]
            }
          }
        }
      },
      "else": { "$ref": "report-create-v4.schema.json#" }
    }
  ],
  "$defs": {
    "plannedTrainingDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetRef"],
      "properties": {
        "kind": { "const": "planned-training" },
        "targetRef": { "$ref": "report-definition-v5.schema.json#/$defs/plannedTargetRef" }
      }
    },
    "draftBlock": {
      "oneOf": [
        { "$ref": "report-create-v4.schema.json#/$defs/draftBlock" },
        { "$ref": "#/$defs/plannedTrainingDraft" }
      ]
    }
  }
}
