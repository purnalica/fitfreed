{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-ranges-v3.schema.json",
  "title": "FitFreed training-session ranges version 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotRef", "sessionRef", "sessionDurationMilliseconds", "evidenceRevision", "exercises", "ranges"],
  "properties": {
    "snapshotRef": { "$ref": "#/$defs/snapshotRef" },
    "sessionRef": { "$ref": "#/$defs/sessionRef" },
    "sessionDurationMilliseconds": { "$ref": "#/$defs/elapsedMilliseconds" },
    "evidenceRevision": { "$ref": "#/$defs/evidenceRevision" },
    "exercises": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/exercise" }
    },
    "ranges": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/range" }
    }
  },
  "$defs": {
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "exerciseRef": { "type": "string", "pattern": "^exercise-[0-9a-f]{64}$" },
    "routeRef": { "type": "string", "pattern": "^route-[0-9a-f]{64}$" },
    "signalRef": { "type": "string", "pattern": "^signal-[0-9a-f]{64}$" },
    "rangeRef": { "type": "string", "pattern": "^range-[0-9a-f]{64}$" },
    "evidenceRevision": { "type": "string", "pattern": "^range-evidence-[0-9a-f]{64}$" },
    "elapsedMilliseconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "positiveMilliseconds": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "exerciseCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": { "scope": { "const": "exercise-elapsed" } }
    },
    "routeCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "routeRef"],
      "properties": {
        "scope": { "const": "route-elapsed" },
        "routeRef": { "$ref": "#/$defs/routeRef" }
      }
    },
    "signalCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "signalRef"],
      "properties": {
        "scope": { "const": "signal-elapsed" },
        "signalRef": { "$ref": "#/$defs/signalRef" }
      }
    },
    "legacyCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": { "scope": { "const": "legacy-session-elapsed" } }
    },
    "currentCoordinate": {
      "oneOf": [
        { "$ref": "#/$defs/exerciseCoordinate" },
        { "$ref": "#/$defs/routeCoordinate" },
        { "$ref": "#/$defs/signalCoordinate" }
      ]
    },
    "coordinate": {
      "oneOf": [
        { "$ref": "#/$defs/exerciseCoordinate" },
        { "$ref": "#/$defs/routeCoordinate" },
        { "$ref": "#/$defs/signalCoordinate" },
        { "$ref": "#/$defs/legacyCoordinate" }
      ]
    },
    "coordinateContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "maximumElapsedMilliseconds"],
      "properties": {
        "coordinate": { "$ref": "#/$defs/currentCoordinate" },
        "maximumElapsedMilliseconds": { "$ref": "#/$defs/elapsedMilliseconds" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseRef", "ordinal", "coordinates"],
      "properties": {
        "exerciseRef": { "$ref": "#/$defs/exerciseRef" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/coordinateContext" }
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rangeRef", "exerciseRef", "coordinate", "title", "startedAtElapsedMilliseconds", "endedAtElapsedMilliseconds", "evidenceRevision", "authorship", "state", "revision"],
      "properties": {
        "rangeRef": { "$ref": "#/$defs/rangeRef" },
        "exerciseRef": {
          "oneOf": [
            { "$ref": "#/$defs/exerciseRef" },
            { "type": "null" }
          ]
        },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "startedAtElapsedMilliseconds": { "$ref": "#/$defs/elapsedMilliseconds" },
        "endedAtElapsedMilliseconds": { "$ref": "#/$defs/positiveMilliseconds" },
        "evidenceRevision": { "$ref": "#/$defs/evidenceRevision" },
        "authorship": { "const": "user" },
        "state": { "enum": ["current", "review-required"] },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "exerciseRef": { "$ref": "#/$defs/exerciseRef" },
            "coordinate": { "$ref": "#/$defs/currentCoordinate" }
          }
        },
        {
          "properties": {
            "exerciseRef": { "type": "null" },
            "coordinate": { "$ref": "#/$defs/legacyCoordinate" },
            "state": { "const": "review-required" }
          }
        }
      ]
    }
  }
}
