{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-search-query-v1.schema.json",
  "title": "FitFreed training-session search query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from",
    "through",
    "sportRefs",
    "requiredMeasurements",
    "text",
    "sort",
    "offset",
    "limit",
    "snapshotRef"
  ],
  "properties": {
    "from": { "$ref": "#/$defs/optionalLocalDate" },
    "through": { "$ref": "#/$defs/optionalLocalDate" },
    "sportRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sportRef" }
    },
    "requiredMeasurements": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["distance", "energy", "heart-rate"] }
    },
    "text": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?=\\S)(?:(?![\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S])*\\S$"
        }
      ]
    },
    "sort": {
      "enum": ["started-desc", "started-asc", "duration-desc", "distance-desc"]
    },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "snapshotRef": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/snapshotRef" }
      ]
    }
  },
  "$defs": {
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "optionalLocalDate": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/localDate" }
      ]
    },
    "sportRef": {
      "type": "string",
      "pattern": "^sport-[0-9a-f]{64}$"
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^training-snapshot-[0-9a-f]{64}$"
    }
  }
}
