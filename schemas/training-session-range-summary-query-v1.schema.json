{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-range-summary-query-v1.schema.json",
  "title": "FitFreed training-session range summary query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "snapshotRef", "rangeRef", "expectedRangeRevision"],
  "properties": {
    "sessionRef": { "type": "string", "pattern": "^session-[0-9a-f]{64}$" },
    "snapshotRef": { "type": "string", "pattern": "^training-snapshot-[0-9a-f]{64}$" },
    "rangeRef": { "type": "string", "pattern": "^range-[0-9a-f]{64}$" },
    "expectedRangeRevision": { "type": "integer", "minimum": 1 }
  }
}
