{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-selection-v1.schema.json",
  "title": "FitFreed training-session selection version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotRef", "sessions"],
  "properties": {
    "snapshotRef": {
      "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-search-v1.schema.json#/$defs/snapshotRef"
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-search-v1.schema.json#/$defs/session"
      }
    }
  }
}
