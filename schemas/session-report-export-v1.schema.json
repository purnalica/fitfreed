{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/session-report-export-v1.schema.json",
  "title": "FitFreed session report export authorization version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportRef",
    "expectedRevision",
    "expectedSourceSnapshotRef",
    "includePhysiologicalContext",
    "destinationPath"
  ],
  "properties": {
    "reportRef": { "$ref": "report-definition-v1.schema.json#/$defs/reportRef" },
    "expectedRevision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "expectedSourceSnapshotRef": {
      "$ref": "report-definition-v1.schema.json#/$defs/snapshotRef"
    },
    "includePhysiologicalContext": { "type": "boolean" },
    "destinationPath": { "type": "string", "minLength": 1, "maxLength": 32768 }
  }
}
