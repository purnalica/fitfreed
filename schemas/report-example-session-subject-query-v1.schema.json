{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/report-example-session-subject-query-v1.schema.json",
  "title": "FitFreed report-example training-session subject query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["exampleId", "exampleVersion", "offset", "limit", "snapshotRef"],
  "properties": {
    "exampleId": { "enum": ["session-visual-story", "outdoor-route"] },
    "exampleVersion": { "const": 1 },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "snapshotRef": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/training-session-search-v4.schema.json#/$defs/snapshotRef" }
      ]
    }
  }
}
