{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purnalica/fitfreed/main/schemas/recovery-detail-query-v1.schema.json",
  "title": "FitFreed recovery detail query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["seriesRef", "recoveryDate"],
  "properties": {
    "seriesRef": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "recoveryDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
