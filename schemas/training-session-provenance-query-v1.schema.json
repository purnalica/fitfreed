{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfreed.org/schemas/training-session-provenance-query-v1.schema.json",
  "title": "FitFreed training-session provenance query version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionRef", "snapshotRef", "offset", "limit"],
  "properties": {
    "sessionRef": {
      "type": "string",
      "pattern": "^session-[0-9a-f]{64}$"
    },
    "snapshotRef": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^training-snapshot-[0-9a-f]{64}$"
        }
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    }
  }
}
