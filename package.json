{
  "name": "fitfreed",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first open-source fitness data explorer",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/purnalica/fitfreed"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.0",
    "serialize-javascript": "7.1.0"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14.0 <25",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "doctor": "scripts/check-development-environment.sh",
    "dev": "vite",
    "build": "tsc && vite build",
    "audit:dependencies": "npm audit --audit-level=high",
    "benchmark:insights": "cargo run --quiet --release --manifest-path src-tauri/Cargo.toml --example insights_benchmark",
    "check:architecture": "node scripts/check-rust-architecture.mjs",
    "check:data-contracts": "node scripts/check-data-contracts.mjs",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "check:vendored-updater": "node scripts/check-vendored-updater.mjs",
    "check:production-bundle": "scripts/check-production-bundle.sh",
    "check:release-contracts": "node scripts/check-release-contracts.mjs",
    "check:upgrade-matrix": "node scripts/upgrade-matrix.mjs",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo fmt --manifest-path src-tauri/vendor/tauri-plugin-updater/Cargo.toml --all -- --check",
    "install:release-tools": "scripts/install-release-tools.sh",
    "lint:rust": "npm run icons && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features -- -D warnings && CARGO_TARGET_DIR=src-tauri/target/vendor-updater cargo clippy --manifest-path src-tauri/vendor/tauri-plugin-updater/Cargo.toml --lib -- -D warnings",
    "icons": "tauri icon assets/brand/fitfreed-icon.svg --output src-tauri/icons",
    "package": "npm run icons && tauri build",
    "prebuild:e2e": "npm run icons && npm run fixture:e2e && npm run fixture:large && npm run fixture:insights-performance",
    "build:e2e": "VITE_FITFREED_E2E=true tauri build --features e2e --config src-tauri/tauri.e2e.conf.json",
    "fixture:e2e": "node scripts/generate-e2e-fixtures.mjs .artifacts/e2e/fixtures",
    "fixture:large": "node scripts/generate-large-fixture.mjs .artifacts/e2e/large.zip",
    "fixture:insights-performance": "node scripts/generate-insights-performance-fixture.mjs .artifacts/e2e/insights-performance.zip",
    "preview": "vite preview",
    "prepare:development-release": "node scripts/prepare-development-release.mjs",
    "test": "vitest run",
    "test:rust": "npm run icons && cargo test --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features",
    "test:vendor-updater": "CARGO_TARGET_DIR=src-tauri/target/vendor-updater cargo test --manifest-path src-tauri/vendor/tauri-plugin-updater/Cargo.toml --lib",
    "test:fast": "npm run check:architecture && npm run check:vendored-updater && npm run check:data-contracts && npm run check:release-contracts && npm run check:upgrade-matrix && npm run check:docs && npm run check:i18n && npm run check:ui-contracts && npm run test:scripts && npm test && npm run test:vendor-updater && npm run test:rust",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:e2e": "wdio run wdio.conf.js",
    "verify:e2e": "npm run build:e2e && npm run test:e2e",
    "verify:development-release": "scripts/verify-macos-development-release.sh",
    "verify:update-recovery-preparation": "scripts/verify-update-recovery-preparation.sh",
    "verify:update-e2e": "node scripts/verify-packaged-update.mjs",
    "verify:full": "npm run doctor && npm run audit:dependencies && npm run test:fast && npm run lint:rust && npm run format:check && npm run benchmark:insights && npm run verify:e2e && npm run verify:update-e2e && npm run package && npm run check:production-bundle && npm run verify:update-recovery-preparation",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  }
}
