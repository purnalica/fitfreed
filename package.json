{
  "name": "fitfreed",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first open-source fitness data explorer",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/purnalica/fitfreed"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.0",
    "deepmerge-ts": "8.0.1",
    "serialize-javascript": "7.1.0"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14.0 <25",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "doctor": "node scripts/check-development-environment.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "audit:dependencies": "npm audit --audit-level=high",
    "benchmark:cold-launch": "node scripts/run-cold-launch-benchmark.mjs",
    "benchmark:dense-history": "node scripts/run-dense-history-benchmark.mjs",
    "benchmark:import": "node scripts/run-import-benchmark.mjs",
    "benchmark:insights": "node scripts/run-insights-benchmark.mjs",
    "build:pages": "node scripts/pages-artifact.mjs .artifacts/pages",
    "catalogue:polar:acquire": "node scripts/acquire-polar-sport-catalogue.mjs .local/research/polar/public-sport-catalogue",
    "catalogue:polar:generate": "node scripts/generate-polar-sport-catalogue.mjs .local/research/polar/public-sport-catalogue/sports.json .local/research/polar/public-sport-catalogue/localization-index.json .local/research/polar/public-sport-catalogue/sport-en.json .local/research/polar/public-sport-catalogue/sport-es.json assets/provider-compatibility/polar-flow-sport-acquisition-v1.json assets/provider-compatibility/polar-flow-sport-family-v1.json assets/provider-compatibility/polar-flow-sport-catalogue-v1.json assets/provider-compatibility/polar-flow-sport-catalogue-v1.manifest.json",
    "check:architecture": "node scripts/check-rust-architecture.mjs",
    "check:data-contracts": "node scripts/check-data-contracts.mjs",
    "check:docs": "node scripts/check-markdown-links.mjs && node scripts/check-public-documentation.mjs && node scripts/check-current-documentation.mjs",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:performance-policy": "node scripts/check-performance-policy.mjs",
    "check:presentation-inventory": "node scripts/presentation-inventory.mjs",
    "check:pages-workflow": "node scripts/pages-workflow.mjs",
    "check:product-surfaces": "node scripts/render-product-surfaces.mjs --check",
    "check:site": "node scripts/check-product-page.mjs",
    "check:public-update-config": "node scripts/public-update-configuration.mjs",
    "check:public-release-signing-config": "node scripts/public-release-signing-configuration.mjs",
    "check:public-release-workflow": "node scripts/public-release-workflow.mjs",
    "check:public-linux-expansion-workflow": "node scripts/public-linux-expansion-workflow.mjs",
    "check:windows-ci-workflow": "node scripts/windows-ci-workflow.mjs",
    "check:public-release-policy": "node scripts/public-release-policy.mjs",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "check:workflows": "scripts/install-workflow-tools.sh && .tools/workflow/actionlint -shellcheck=.tools/workflow/shellcheck",
    "check:vendored-updater": "node scripts/check-vendored-updater.mjs",
    "check:production-bundle": "scripts/check-production-bundle.sh",
    "check:x6-review-bundle": "node scripts/check-x6-review-bundle.mjs",
    "check:public-macos-trust": "node scripts/macos-public-trust.mjs",
    "check:release-contracts": "node scripts/check-release-contracts.mjs",
    "check:upgrade-matrix": "node scripts/upgrade-matrix.mjs",
    "format:check": "node scripts/run-rust-quality.mjs format",
    "install:release-tools": "scripts/install-release-tools.sh",
    "install:workflow-tools": "scripts/install-workflow-tools.sh",
    "lint:rust": "npm run icons && node scripts/run-rust-quality.mjs lint",
    "icons": "tauri icon assets/brand/fitfreed-icon.svg --output src-tauri/icons",
    "inventory:linux-package": "node scripts/linux-package-inventory.mjs",
    "inventory:windows-package": "node scripts/windows-package-inventory.mjs",
    "verify:windows-authenticode-smoke": "node scripts/windows-authenticode-smoke.mjs",
    "package": "npm run icons && node scripts/build-production.mjs",
    "build:windows-host": "npm run icons && node scripts/run-rust-quality.mjs build",
    "package:app": "npm run icons && node scripts/build-production.mjs --bundles app",
    "package:linux": "npm run icons && node scripts/build-linux-package.mjs",
    "package:linux-expansion-input": "npm run icons && node scripts/build-linux-expansion-input.mjs",
    "package:linux-public-candidate": "npm run icons && node scripts/build-linux-public-candidate.mjs",
    "package:public-candidate": "npm run icons && node scripts/build-public-candidate.mjs",
    "package:windows": "npm run icons && node scripts/build-windows-package.mjs",
    "package:windows-expansion-input": "npm run icons && node scripts/build-windows-expansion-input.mjs",
    "build:x6-review": "npm run icons && node scripts/build-x6-review.mjs",
    "launch:x6-review": "node scripts/run-x6-human-review.mjs",
    "review:x6": "npm run build:x6-review && npm run check:x6-review-bundle && npm run launch:x6-review",
    "pack:public-release": "node scripts/public-release-transport.mjs pack",
    "pack:linux-expansion-input": "node scripts/linux-expansion-input-transport.mjs pack",
    "pack:windows-expansion-input": "node scripts/windows-expansion-input-transport.mjs pack",
    "authority:public-release": "node scripts/public-release-authority.mjs",
    "publish:public-release": "node scripts/public-release-publication.mjs publish",
    "check:release-immutability": "node scripts/public-release-publication.mjs check-immutability",
    "preflight:public-release": "node scripts/public-release-preflight.mjs",
    "preflight:linux-expansion": "node scripts/public-linux-expansion-preflight.mjs",
    "prebuild:e2e": "npm run icons && npm run fixture:e2e && npm run fixture:large && npm run fixture:insights-performance",
    "build:e2e": "node scripts/build-e2e.mjs",
    "build:e2e:linux-package": "node scripts/build-linux-e2e-package.mjs",
    "build:e2e:windows-package": "node scripts/build-windows-e2e-package.mjs",
    "fixture:e2e": "node scripts/generate-e2e-fixtures.mjs .artifacts/e2e/fixtures",
    "fixture:dense-history": "node scripts/generate-dense-history-fixture.mjs .artifacts/e2e/dense-history.zip",
    "fixture:large": "node scripts/generate-large-fixture.mjs .artifacts/e2e/large.zip",
    "fixture:insights-performance": "node scripts/generate-insights-performance-fixture.mjs .artifacts/e2e/insights-performance.zip",
    "preview": "vite preview",
    "prepare:development-release": "node scripts/prepare-development-release.mjs",
    "prepare:complete-platform-release": "node scripts/prepare-complete-platform-release.mjs",
    "prepare:linux-expansion-input": "node scripts/prepare-linux-expansion-input.mjs",
    "prepare:windows-expansion-input": "node scripts/prepare-windows-expansion-input.mjs",
    "prepare:linux-expansion-release": "node scripts/prepare-expanding-public-release.mjs",
    "prepare:public-release": "node scripts/prepare-public-release.mjs",
    "render:product-surfaces": "node scripts/render-product-surfaces.mjs",
    "test": "vitest run",
    "test:rust": "npm run icons && node scripts/run-rust-quality.mjs test",
    "test:vendor-updater": "node scripts/run-rust-quality.mjs test-vendor",
    "unpack:public-release": "node scripts/public-release-transport.mjs unpack",
    "unpack:linux-expansion-input": "node scripts/linux-expansion-input-transport.mjs unpack",
    "unpack:windows-expansion-input": "node scripts/windows-expansion-input-transport.mjs unpack",
    "test:fast": "npm run check:architecture && npm run check:vendored-updater && npm run check:data-contracts && npm run check:release-contracts && npm run check:upgrade-matrix && npm run check:performance-policy && npm run check:public-update-config && npm run check:public-release-signing-config && npm run check:public-release-policy && npm run check:public-release-workflow && npm run check:public-linux-expansion-workflow && npm run check:windows-ci-workflow && npm run check:pages-workflow && npm run check:workflows && npm run check:product-surfaces && npm run check:docs && npm run check:site && npm run check:i18n && npm run check:presentation-inventory && npm run check:ui-contracts && npm run test:scripts && npm test && npm run test:vendor-updater && npm run test:rust",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:windows-scripts": "node --test scripts/cold-launch-benchmark.test.mjs scripts/development-environment.test.mjs scripts/performance-benchmark-profile.test.mjs scripts/rust-quality.test.mjs scripts/windows-authenticode-sign.test.mjs scripts/windows-authenticode-smoke.test.mjs scripts/windows-authenticode-trust.test.mjs scripts/windows-ci-workflow.test.mjs scripts/windows-cold-launch.test.mjs scripts/windows-expansion-build.test.mjs scripts/windows-expansion-input-transport.test.mjs scripts/windows-filesystem-reliability.test.mjs scripts/windows-installed-package.test.mjs scripts/windows-package-configuration.test.mjs scripts/windows-package-installation.test.mjs scripts/windows-package-inventory.test.mjs scripts/windows-packaged-e2e.test.mjs scripts/windows-performance-workflow.test.mjs scripts/windows-public-build-evidence.test.mjs scripts/windows-update-e2e.test.mjs scripts/prepare-windows-expansion-input.test.mjs scripts/windows-verification-evidence.test.mjs scripts/packaged-e2e-configuration.test.mjs scripts/update-e2e-contract.test.mjs",
    "test:product-site": "node --test scripts/pages-artifact.test.mjs scripts/pages-publication.test.mjs scripts/pages-workflow.test.mjs scripts/product-page-localization.test.mjs scripts/public-origin.test.mjs scripts/render-product-surfaces.test.mjs",
    "test:e2e": "node scripts/run-packaged-e2e.mjs",
    "test:e2e:linux-package": "node scripts/run-packaged-linux-e2e.mjs",
    "test:e2e:windows-package": "node scripts/run-packaged-windows-e2e.mjs",
    "verify:e2e": "npm run build:e2e && npm run test:e2e",
    "verify:linux-e2e": "npm run prebuild:e2e && npm run build:e2e:linux-package && npm run test:e2e:linux-package",
    "verify:windows-e2e": "npm run prebuild:e2e && npm run build:e2e:windows-package && npm run test:e2e:windows-package",
    "verify:development-release": "scripts/verify-macos-development-release.sh",
    "verify:update-recovery-preparation": "scripts/verify-update-recovery-preparation.sh",
    "verify:linux-installation": "node scripts/verify-linux-clean-install.mjs",
    "verify:linux-candidate-installation": "node scripts/verify-linux-candidate-installation.mjs",
    "verify:linux-filesystem-reliability": "scripts/verify-linux-filesystem-reliability.sh",
    "verify:linux-package": "node scripts/verify-linux-debian-package.mjs",
    "verify:linux-public-release": "node scripts/verify-linux-public-release.mjs",
    "verify:windows-installation": "node scripts/verify-windows-package-installation.mjs",
    "verify:windows-cold-launch": "node scripts/verify-windows-cold-launch.mjs",
    "verify:windows-filesystem-reliability": "node scripts/verify-windows-filesystem-reliability.mjs",
    "verify:expanding-public-release": "node scripts/verify-expanding-public-release.mjs",
    "verify:complete-platform-release": "node scripts/verify-complete-platform-release.mjs",
    "verify:linux-update-e2e": "npm run icons && node scripts/verify-packaged-linux-update.mjs",
    "verify:windows-update-e2e": "npm run icons && node scripts/verify-packaged-windows-update.mjs",
    "verify:update-e2e": "node scripts/verify-packaged-update.mjs",
    "verify:public-release": "node scripts/public-release-candidate-verification.mjs",
    "verify:pages:preflight": "node scripts/pages-publication.mjs preflight .artifacts/pages",
    "verify:pages:remote": "node scripts/pages-publication.mjs verify .artifacts/pages",
    "verify:remote-public-release": "node scripts/public-release-remote.mjs",
    "verify:precommit": "npm run doctor && npm run audit:dependencies && npm run test:fast && npm run lint:rust && npm run format:check && npm run benchmark:import && npm run benchmark:dense-history && npm run benchmark:insights && npm run verify:e2e && npm run verify:update-e2e && npm run package",
    "verify:full": "npm run verify:precommit && npm run benchmark:cold-launch && npm run check:production-bundle && npm run verify:update-recovery-preparation",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/leaflet": "1.9.22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  }
}
