{
  "name": "fitfreed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14.0 <25",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:architecture": "node scripts/check-rust-architecture.mjs",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:production-bundle": "scripts/check-production-bundle.sh",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "icons": "tauri icon assets/brand/fitfreed-icon.svg --output src-tauri/icons",
    "package": "npm run icons && tauri build",
    "prebuild:e2e": "npm run icons && npm run fixture:e2e && npm run fixture:large",
    "build:e2e": "VITE_FITFREED_E2E=true tauri build --features e2e --config src-tauri/tauri.e2e.conf.json",
    "fixture:e2e": "node scripts/generate-e2e-fixtures.mjs .artifacts/e2e/fixtures",
    "fixture:large": "node scripts/generate-large-fixture.mjs .artifacts/e2e/large.zip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --all-features",
    "test:fast": "npm run check:architecture && npm run check:docs && npm run check:i18n && npm test && npm run test:rust",
    "test:e2e": "wdio run wdio.conf.js",
    "verify:e2e": "npm run build:e2e && npm run test:e2e",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.13.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  }
}
